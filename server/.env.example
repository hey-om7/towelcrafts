PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/towel_crafts
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRE=30d
CORS_ORIGIN=http://localhost:3000

# Google OAuth — must match the Client ID used by the frontend.
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────
# Email (SMTP) — used to send order-confirmation emails.
# For Gmail: set EMAIL_USER to your Gmail address and EMAIL_PASS to a
# 16-character App Password (https://myaccount.google.com/apppasswords),
# NOT your normal account password. Leave EMAIL_USER blank to disable email.
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=TowelCrafts
# Optional: public store URL used for links/buttons in emails
STORE_URL=http://localhost:3000

# Fixed approver address that must confirm any admin-role promotion via emailed OTP.
ADMIN_APPROVER_EMAIL=om.ambarkar@gmail.com

# ─────────────────────────────────────────────
# Razorpay (online payments).
# Create keys in the Razorpay Dashboard → Settings → API Keys.
#   • Test mode keys start with "rzp_test_"; live keys start with "rzp_live_".
#   • RAZORPAY_KEY_ID is public (sent to the browser).
#   • RAZORPAY_KEY_SECRET is private — never expose it to the frontend.
# Leave both blank to disable online payments (COD still works).
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# ─────────────────────────────────────────────
# Cloudflare R2 (S3-compatible) image storage.
# Create an R2 bucket + API token in the Cloudflare dashboard, then either
# enable the r2.dev public subdomain or bind a custom domain, and set that
# public base URL as R2_PUBLIC_URL (no trailing slash).
# Leave these blank to disable R2 uploads (existing /public paths still work).
# ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=towelcrafts
# Optional explicit endpoint (overrides the account-id host if set):
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# Public read base — custom domain (e.g. https://cdn.towelcrafts.com) or
# the bucket's r2.dev URL (e.g. https://pub-xxxx.r2.dev):
R2_PUBLIC_URL=
