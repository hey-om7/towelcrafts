# Frontend environment variables (Create React App)
# The API base URL for the backend server
REACT_APP_API_URL=http://localhost:5001

# Google OAuth Client ID — obtain from https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" of type "Web application" and add your domain
# to Authorized JavaScript origins. Leave empty to hide the Google Sign-In button.
REACT_APP_GOOGLE_CLIENT_ID=
